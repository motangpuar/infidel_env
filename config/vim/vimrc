" ============================================================================
" infiler vimrc — Cleaned, best‑practice, Vim9‑compatible
" ============================================================================
set nocompatible                               " Disable Vi compatibility
set encoding=utf-8                            " UTF‑8 encoding
set fileencoding=utf-8                        " UTF‑8 file encoding
set autoread                                  " Auto‑re-read changed files
set hidden                                    " Switch buffers without saving

filetype plugin indent on
syntax enable

let mapleader = ","                          " Default leader key
let maplocalleader = ","                     " Default localleader

" ============================================================================
" Plugins (vim-plug)
" ============================================================================
call plug#begin('~/.vim/plugged')

" ============== Essentials ==============
Plug 'jasonccox/vim-wayland-clipboard'
Plug 'tpope/vim-sensible'                     " Sensible defaults
Plug 'preservim/nerdtree', { 'on': 'NERDTreeToggle' } " File explorer
Plug 'junegunn/vim-easy-align'
Plug 'junegunn/fzf.vim'
Plug 'junegunn/goyo.vim'
Plug 'junegunn/limelight.vim'
Plug 'gyim/vim-boxdraw'
Plug 'vim-airline/vim-airline'
Plug 'vim-airline/vim-airline-themes'
Plug 'ojroques/vim-oscyank'
Plug 'ryanoasis/vim-devicons'

" ============== Completion & Tools ==============
Plug 'neoclide/coc.nvim', {'branch': 'release'}
Plug 'evanleck/vim-svelte'
Plug 'wakatime/vim-wakatime'
Plug 'sbdchd/neoformat'

" ============== Custom ==============
Plug 'motangpuar/leetcode.vim', {'branch': 'custom_path'}

" ============== Colorschemes ==============
Plug 'sainnhe/gruvbox-material'
Plug 'rakr/vim-two-firewatch'
Plug 'joshdick/onedark.vim'
Plug 'drewtempelmeyer/palenight.vim'
Plug 'kaicataldo/material.vim', {'branch': 'main'}
Plug 'sainnhe/vim-color-forest-night'
Plug 'karoliskoncevicius/sacredforest-vim'
Plug 'junegunn/seoul256.vim'

" ============== Misc ==============
Plug 'lervag/vimtex'
Plug 'wellle/context.vim'

" ============== Markdown ==============
Plug 'liuchengxu/vista.vim'
Plug 'iamcco/markdown-preview.nvim', {'do': { -> mkdp#util#install() }}

call plug#end()

" ============================================================================
" Core Options
" ============================================================================
set number                                     " Show line numbers
set hlsearch                                  " Highlight search results
set ignorecase                                " Ignore case in searches
set smartcase                                 " Override if pattern has uppercase

set mouse=a                                   " Enable mouse in all modes

if has('clipboard')
    set clipboard=unnamed,unnamedplus         " Use OS clipboard
endif

set showmatch                                 " Auto‑match brackets
set termguicolors                             " 24‑bit RGB colour support
set lazyredraw                               " Speed up redraws during scripts
set updatetime=300                           " Min latency for completions / OSC

set tabstop=4                               " Tab width: 4 spaces
set softtabstop=4                           " Insert: 4 spaces for tab
set shiftwidth=4                            " Auto‑indent width
set expandtab                               " Use spaces instead of tabs

set noswapfile                               " Don't create swap files

set nowrap                                  " Disable line wrapping
set list lcs=tab:>-                          " Show tabs as filled triangle (2‑char spec)
set showbreak=...                            " Line‑continuation marker

set completeopt=menu,menuone,noselect,noinsert " Completion options
set splitright splitbelow                   " New splits right / below

" Terminal cursor shape (Vim — not Neovim)
if !has('nvim')
    let &t_SI="\e[6 q"  " Steady vertical bar in insert mode
    let &t_EI="\e[2 q"  " Steady block in normal mode
endif

" --------------------------------------------------------
" Kitty terminal patch (only when running in kitty, not nvim)
" --------------------------------------------------------
if &term =~# 'kitty' && !has('nvim')
    let &t_ut=''
    " Set terminal default fg/bg (OSC 10/11) — dark bg + light fg, else text is invisible
    let &t_ti=&t_ti . "\033]10;#f6f3e8\007\033]11;#242424\007"
    let &t_te=&t_te . "\033]110\007\033]111\007"
endif

" --------------------------------------------------------
" Colourscheme
" --------------------------------------------------------
set background=light
" Primary scheme: seoul256-light (original scheme). Falls back gracefully.
silent! colorscheme seoul256-light
if !exists('g:colors_name') || g:colors_name !~# '^seoul256'
    silent! colorscheme gruvbox-material   " fallback
endif

" --------------------------------------------------------
" Airline / Tabline
" --------------------------------------------------------
let g:airline_theme = 'sacredforest'
let g:airline_powerline_fonts = 1
let g:airline#extensions#tabline#enabled = 1
let g:airline#extensions#tabline#show_tabs = 1
let g:airline#extensions#tabline#show_buffers = 0
let g:airline#extensions#tabline#show_tab_nr = 1
let g:airline#extensions#tabline#tab_nr_type = 1
let g:airline#extensions#tabline#left_sep  = "\uE0B4"
let g:airline#extensions#tabline#right_sep = "\uE0B6"
let g:airline#extensions#tabline#left_alt_sep  = "\u2022"
let g:airline#extensions#tabline#right_alt_sep = "\u2022"
let g:airline_left_sep  = "\uE0B4"
let g:airline_right_sep = "\uE0B6"
let g:airline_left_alt_sep  = "\u2022"
let g:airline_right_alt_sep = "\u2022"

" --------------------------------------------------------
" Limelight + Goyo
" --------------------------------------------------------
let g:limelight_conceal_ctermfg = 'gray'
let g:limelight_default_coefficient = 0.7
let g:limelight_priority = -1

autocmd! User GoyoEnter Limelight       " Call Limelight on Goyo enter
autocmd! User GoyoLeave Limelight!
nnoremap <F8> : Goyo<cr>                  " Toggle Goyo

" --------------------------------------------------------
" VimTex (LaTeX)
" --------------------------------------------------------
let g:vimtex_view_method = 'zathura'
let g:vimtex_view_general_viewer = 'okular'
let g:vimtex_quickfix_autoclose_after_keystrokes = 1
let g:vimtex_view_general_options = '--unique file:@pdf#src:@line@tex'
let g:vimtex_compiler_method = 'latexmk'
let maplocalleader = ","

" --------------------------------------------------------
" Coc / Tabs / Navigation
" --------------------------------------------------------
let g:coc_disable_startup_warning = 1
let g:markdown_fenced_languages = [            'vim',             'help']

" ---- CoC insert‑mode completion ----
" <TAB>  : cycle completion / trigger completion
" <S-TAB>: literal tab (insert mode)
" <CR>   : accept completion when the popup is open
function! s:check_back_space() abort
    let l:col = col('.') - 1
    return !l:col || getline('.')[l:col - 1] =~# '\s'
endfunction

inoremap <silent><expr> <TAB>
      \ pumvisible() ? "\<C-n>" :
      \ <SID>check_back_space() ? "\<TAB>" :
      \ coc#refresh()
inoremap <silent><expr> <S-TAB> pumvisible() ? "\<C-p>" : "\<TAB>"
inoremap <silent><expr> <CR> pumvisible() ? coc#_select_confirm() : "\<C-g>u\<CR>"

nnoremap <C-p> :Files<cr>                  " Fuzzy file opener (fzf.vim)
nnoremap <C-k><C-k> :NERDTreeToggle<cr>         " Toggle NERDTree

" --------------------------------------------------------
" Visual block indent & move
" --------------------------------------------------------
" Keep visual selection after indent
vnoremap < >gv
vnoremap < <gv
" Move visual blocks J / K
vnoremap J :m '>+1<CR>gv=gv
vnoremap K :m '<-2<CR>gv=gv

" --------------------------------------------------------
" Cursor position recall
" --------------------------------------------------------
augroup RecallCursorPos
    autocmd!
    autocmd BufReadPost * if line("'\"") > 1 | exe "normal! g'\"" | endif
augroup END

" --------------------------------------------------------
" Tab numbers (1‑9)
" --------------------------------------------------------
nnoremap <Leader>1 1gt
nnoremap <Leader>2 2gt
nnoremap <Leader>3 3gt
nnoremap <Leader>4 4gt
nnoremap <Leader>5 5gt
nnoremap <Leader>6 6gt
nnoremap <Leader>7 7gt
nnoremap <Leader>8 8gt
nnoremap <Leader>9 9gt

" --------------------------------------------------------
" Neoformat (auto on save)
" --------------------------------------------------------
augroup NeoformatAuto
    autocmd!
    autocmd BufWritePre *.js *.py *.cpp *.go *.yaml *.json Neoformat
augroup END

" --------------------------------------------------------
" LeetCode
" --------------------------------------------------------
let g:leetcode_solution_filetype = 'golang'
nnoremap <leader>ll :LeetCodeList<cr>
nnoremap <leader>lt :LeetCodeTest<cr>
nnoremap <leader>ls :LeetCodeSubmit<cr>
nnoremap <leader>li :LeetCodeSignIn<cr>

" --------------------------------------------------------
" Miscellaneous
" --------------------------------------------------------
set colorcolumn=80
let g:context_enabled = 1
vmap <leader>y <Plug>OSCYankVisual          " Copy Yank to window manager

" End vimrc"
