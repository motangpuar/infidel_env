layout {
    default_tab_template {
        // --- 1. TOP BAR ---
        pane size=1 borderless=true {
            plugin location="zjstatus" {
                color_bg      "#e4e4e4"
                color_surface "#d0d0d0"
                color_text    "#4e4e4e"
                color_subtext "#878787"
                color_blue    "#5f87ae"
                color_red     "#af5f5f"
                color_orange  "#af8760"
                color_green   "#5f885f"

                format_left   "{mode}#[bg=$bg] {tabs}"
                format_center ""
                format_right  "#[fg=$surface,bg=$bg]#[fg=$text,bg=$surface]{datetime}"
                format_space  "#[bg=$bg]"

                mode_normal  "#[fg=$blue,bg=$bg]#[fg=$bg,bg=$blue,bold] NORMAL #[fg=$blue,bg=$bg]"
                mode_locked  "#[fg=$red,bg=$bg]#[fg=$bg,bg=$red,bold] LOCKED #[fg=$red,bg=$bg]"
                mode_resize  "#[fg=$orange,bg=$bg]#[fg=$bg,bg=$orange,bold] RESIZE #[fg=$orange,bg=$bg]"
                mode_pane    "#[fg=$blue,bg=$bg]#[fg=$bg,bg=$blue,bold] PANE   #[fg=$blue,bg=$bg]"
                mode_tab     "#[fg=$blue,bg=$bg]#[fg=$bg,bg=$blue,bold] TAB    #[fg=$blue,bg=$bg]"
                mode_move    "#[fg=$orange,bg=$bg]#[fg=$bg,bg=$orange,bold] MOVE   #[fg=$orange,bg=$bg]"
                mode_session "#[fg=$green,bg=$bg]#[fg=$bg,bg=$green,bold] SESSION #[fg=$green,bg=$bg]"

                tab_normal   "#[fg=$surface,bg=$bg]#[fg=$subtext,bg=$surface]{index}: {name}#[fg=$surface,bg=$bg] "
                tab_active   "#[fg=$green,bg=$bg]#[fg=$bg,bg=$green,bold]{index}: {name}#[fg=$green,bg=$bg] "

                datetime        " #[fg=$text,bg=$surface,bold]{format}#[fg=$surface,bg=$bg]"
                datetime_format "%H:%M"
                datetime_timezone "America/New_York"
            }
        }

        // --- 2. WORKSPACE ---
        children

        // --- 3. BOTTOM BAR: Contextual Mode-Aware Menu Options ---
        pane size=1 borderless=true {
            plugin location="zjstatus" {
                color_bg      "#e4e4e4"
                color_surface "#d0d0d0"
                color_text    "#4e4e4e"
                color_blue    "#5f87ae"
                color_red     "#af5f5f"
                color_orange  "#af8760"
                color_green   "#5f885f"

                format_left   "#[fg=$text,bg=$bg]   {mode}"
                format_center ""
                format_right  ""
                format_space  "#[bg=$bg]"

                // Custom Rounded Hints that swap out instantly based on the active mode string!
                mode_normal  "#[fg=$surface,bg=$bg]#[fg=$blue,bg=$surface,bold]Ctrl+Space#[fg=$text,bg=$surface] Tab #[fg=$surface,bg=$bg]  #[fg=$surface,bg=$bg]#[fg=$blue,bg=$surface,bold]Ctrl+p#[fg=$text,bg=$surface] Pane #[fg=$surface,bg=$bg]  #[fg=$surface,bg=$bg]#[fg=$green,bg=$surface,bold]Ctrl+o#[fg=$text,bg=$surface] Session #[fg=$surface,bg=$bg]"

                mode_tab     "#[fg=$surface,bg=$bg]#[fg=$green,bg=$surface,bold] n #[fg=$text,bg=$surface]New #[fg=$surface,bg=$bg]  #[fg=$surface,bg=$bg]#[fg=$red,bg=$surface,bold] x #[fg=$text,bg=$surface]Close #[fg=$surface,bg=$bg]  #[fg=$surface,bg=$bg]#[fg=$blue,bg=$surface,bold]Ctrl+Space#[fg=$text,bg=$surface] Normal #[fg=$surface,bg=$bg]"

                mode_pane    "#[fg=$surface,bg=$bg]#[fg=$green,bg=$surface,bold] d #[fg=$text,bg=$surface]Split Down #[fg=$surface,bg=$bg]  #[fg=$surface,bg=$bg]#[fg=$green,bg=$surface,bold] r #[fg=$text,bg=$surface]Split Right #[fg=$surface,bg=$bg]  #[fg=$surface,bg=$bg]#[fg=$orange,bg=$surface,bold] s #[fg=$text,bg=$surface]Stack #[fg=$surface,bg=$bg]"

                mode_session "#[fg=$surface,bg=$bg]#[fg=$green,bg=$surface,bold] w #[fg=$text,bg=$surface]Sessions #[fg=$surface,bg=$bg]  #[fg=$surface,bg=$bg]#[fg=$red,bg=$surface,bold] Ctrl+q #[fg=$text,bg=$surface]Quit #[fg=$surface,bg=$bg]"

                mode_move    "#[fg=$surface,bg=$bg]#[fg=$text,bg=$surface]hjkl / Arrows to Move Panes#[fg=$surface,bg=$bg]"
                mode_resize  "#[fg=$surface,bg=$bg]#[fg=$text,bg=$surface]hjkl / Arrows to Resize Panes#[fg=$surface,bg=$bg]"
                mode_locked  "#[fg=$surface,bg=$bg]#[fg=$red,bg=$surface,bold]Ctrl+g#[fg=$text,bg=$surface] Unlock #[fg=$surface,bg=$bg]"
            }
        }
    }
}

